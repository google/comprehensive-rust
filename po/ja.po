msgid ""
"/// This returns an FFI-friendly equivalent of `Result<PngReader<'a>,\n"
"        /// ()>`.\n"
msgstr ""
"/// これは `Result<PngReader<'a>,()>` と同等の FFI 対応の結果を\n"
